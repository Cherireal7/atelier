{
  "name": "@atelier/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared UI primitives for Etege — Button, Input, Card. Source-first (ships TSX); consumers transpile.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/button/index.ts",
    "./input": "./src/input/index.ts",
    "./card": "./src/card/index.ts",
    "./cn": "./src/utils/cn.ts"
  },
  "files": ["src"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no linter yet)\" && exit 0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@atelier/tokens": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
