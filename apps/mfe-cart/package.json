{
  "name": "@atelier/mfe-cart",
  "version": "0.0.0",
  "private": true,
  "description": "Cart micro frontend — pure CSR SPA on Vite + React. Served under /cart via the shell's rewrite (dev) or Nginx (prod). Runs standalone on port 4402.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4402",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atelier/tokens": "workspace:*",
    "@atelier/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
