{
  "name": "@atelier/mfe-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Catalog micro frontend — SSR product listing + detail. Served under /collection via the shell's rewrite (dev) or Nginx (prod). Runs standalone on port 4401.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4401 --turbopack",
    "build": "next build",
    "start": "next start --port 4401",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@atelier/tokens": "workspace:*",
    "@atelier/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  }
}
